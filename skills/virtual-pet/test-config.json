{
  "test_scenario": "project_creation",
  "expected_files": [
    "VirtualPet.xcodeproj",
    "VirtualPet",
    "VirtualPet/Pet.swift",
    "VirtualPet/ContentView.swift",
    "VirtualPet/VirtualPetApp.swift",
    "Assets.xcassets",
    "Info.plist"
  ],
  "pet_types": ["cat", "dog", "rabbit", "hamster", "bird"],
  "default_settings": {
    "initial_hunger": 50,
    "initial_happiness": 50,
    "initial_health": 100,
    "initial_energy": 100,
    "include_achievements": true,
    "include_animations": true
  },
  "test_cases": [
    {
      "name": "basic_creation",
      "params": {
        "project_name": "TestPet",
        "pet_type": "cat"
      },
      "expected": {
        "pet_type": "cat",
        "has_achievements": true
      }
    },
    {
      "name": "dog_project",
      "params": {
        "project_name": "DogPet",
        "pet_type": "dog"
      },
      "expected": {
        "pet_type": "dog",
        "bundle_id": "com.example.dogpet"
      }
    },
    {
      "name": "no_achievements",
      "params": {
        "project_name": "SimplePet",
        "pet_type": "rabbit",
        "no_achievements": true
      },
      "expected": {
        "pet_type": "rabbit",
        "has_achievements": false
      }
    }
  ]
}