{
  "name": "virtual-pet",
  "description": "创建和管理虚拟宠物iOS应用的技能",
  "version": "1.0.0",
  "author": "VirtualPet Studio",
  "license": "MIT",
  "keywords": ["ios", "swift", "swiftui", "virtual-pet", "xcode"],
  "category": "development",
  "tags": ["ios", "mobile", "swift", "game", "pet"],
  "icon": "🐱",
  "commands": {
    "create": {
      "description": "创建新的虚拟宠物iOS项目",
      "usage": "virtual-pet create --project-name <name> --pet-type <type> --deployment-target <target> --bundle-id <id>",
      "options": {
        "--project-name": {
          "type": "string",
          "required": true,
          "description": "项目名称",
          "example": "MyPet"
        },
        "--pet-type": {
          "type": "string",
          "required": false,
          "default": "cat",
          "description": "宠物类型（cat, dog, rabbit, hamster, bird）",
          "example": "dog"
        },
        "--deployment-target": {
          "type": "string",
          "required": false,
          "default": "17.0",
          "description": "iOS部署目标版本",
          "example": "17.0"
        },
        "--bundle-id": {
          "type": "string",
          "required": false,
          "description": "应用Bundle ID",
          "example": "com.example.mypet"
        },
        "--initial-hunger": {
          "type": "number",
          "required": false,
          "default": 30,
          "description": "初始饥饿度（0-100）"
        },
        "--initial-happiness": {
          "type": "number",
          "required": false,
          "default": 50,
          "description": "初始快乐度（0-100）"
        },
        "--initial-health": {
          "type": "number",
          "required": false,
          "default": 80,
          "description": "初始健康度（0-100）"
        },
        "--initial-energy": {
          "type": "number",
          "required": false,
          "default": 70,
          "description": "初始能量（0-100）"
        },
        "--initial-experience": {
          "type": "number",
          "required": false,
          "default": 0,
          "description": "初始经验值"
        },
        "--initial-level": {
          "type": "number",
          "required": false,
          "default": 1,
          "description": "初始等级"
        },
        "--output-dir": {
          "type": "string",
          "required": false,
          "description": "输出目录（默认当前目录）"
        }
      }
    },
    "list": {
      "description": "列出支持的宠物类型",
      "usage": "virtual-pet list"
    }
  },
  "pet-types": {
    "cat": {
      "name": "猫咪",
      "emoji": "🐱",
      "color": "orange",
      "description": "可爱的猫咪，橙色，默认宠物类型"
    },
    "dog": {
      "name": "狗狗",
      "emoji": "🐶",
      "color": "brown",
      "description": "忠诚的狗狗，棕色"
    },
    "rabbit": {
      "name": "兔子",
      "emoji": "🐰",
      "color": "pink",
      "description": "温顺的兔子，粉色"
    },
    "hamster": {
      "name": "仓鼠",
      "emoji": "🐹",
      "color": "yellow",
      "description": "活泼的仓鼠，黄色"
    },
    "bird": {
      "name": "小鸟",
      "emoji": "🐦",
      "color": "blue",
      "description": "自由的小鸟，蓝色"
    }
  },
  "platforms": ["ios"],
  "swift-version": "5.0",
  "xcode-version": "15.0+"
}
