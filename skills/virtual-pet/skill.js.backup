const fs = require('fs');
const path = require('path');
const { exec } = require('child_process');

class VirtualPetSkill {
  constructor() {
    this.skillConfig = null;
    this.projectDir = process.cwd();
  }

  loadConfig(configPath) {
    try {
      const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
      this.skillConfig = config;
      return config;
    } catch (error) {
      console.error('Error loading JSON config:', error.message);
    }

    try {
      const yamlPath = configPath.replace('.json', '.yaml');
      if (fs.existsSync(yamlPath)) {
        // Simple YAML parsing for basic key-value pairs
        const yamlContent = fs.readFileSync(yamlPath, 'utf8');
        const config = this.parseSimpleYAML(yamlContent);
        this.skillConfig = config;
        return config;
      }
    } catch (error) {
      console.error('Error loading YAML config:', error.message);
    }

    throw new Error('Skill configuration not found');
  }

  listSkills() {
    const skillsDir = path.join(__dirname, '..', '..');
    const skills = [];

    for (const skillDir of fs.readdirSync(skillsDir)) {
      const skillPath = path.join(skillsDir, skillDir);
      if (fs.statSync(skillPath).isDirectory() && fs.existsSync(path.join(skillPath, 'skill.json'))) {
        const configPath = path.join(skillPath, 'skill.json');
        try {
          const config = this.loadConfig(configPath);
          skills.push({
            name: config.name || 'Unknown',
            version: config.version || '0.0.0',
            description: config.description || 'No description',
            author: config.author || 'Unknown'
          });
        } catch (e) {
          console.error(`Error loading skill config for ${skillDir}: ${e}`);
        }
      }
    }

    console.log('Available Skills:');
    console.log('================');
    skills.forEach(skill => {
      console.log(`${skill.name} v${skill.version}`);
      console.log(`  ${skill.description}`);
      console.log(`  by ${skill.author}`);
      console.log('');
    });

    return skills;
  }

  createProject(options = {}) {
    const {
      projectDir = this.projectDir,
      projectName = 'VirtualPet',
      petType = 'cat',
      bundleId = 'com.example.virtualpet',
      deploymentTarget = '17.0',
      includeAchievements = true,
      includeAnimations = true,
      includeDataPersistence = true,
      includeActivityLog = true
    } = options;

    const projectPath = path.join(projectDir, projectName);

    console.log(`Creating VirtualPet project: ${projectName}`);
    console.log(`Project directory: ${projectPath}`);
    console.log(`Pet type: ${petType}`);

    // Check if project directory exists
    if (fs.existsSync(projectPath)) {
      console.error(`Project directory already exists: ${projectPath}`);
      return false;
    }

    // Create project directory
    fs.mkdirSync(projectPath, { recursive: true });

    // Generate project files
    this.generateProjectFiles({
      projectPath,
      projectName,
      petType,
      bundleId,
      deploymentTarget,
      includeAchievements,
      includeAnimations,
      includeDataPersistence,
      includeActivityLog
    });

    console.log(`✅ VirtualPet project created successfully!`);
    console.log(``);
    console.log(`Next steps:`);
    console.log(`  cd ${projectPath}`);
    console.log(`  open ${projectName}.xcodeproj`);
    console.log(`  or xcodebuild -project ${projectName}.xcodeproj -scheme ${projectName} build`);

    return true;
  }

  generateProjectFiles(options) {
    const { projectPath, projectName, petType, bundleId } = options;
    const sourcePath = path.join(__dirname, '..', '..', 'VirtualPet');

    // Copy source files
    this.copyDirectory(sourcePath, projectPath);

    // Update pet type in Pet.swift
    const petFilePath = path.join(projectPath, 'Pet.swift');
    if (fs.existsSync(petFilePath)) {
      let content = fs.readFileSync(petFilePath, 'utf8');

      // Replace default pet type
      content = content.replace(/petType: PetType = \.cat/g, `petType: PetType = .${petType}`);

      // Replace project name references
      content = content.replace(/VirtualPet/g, projectName);

      fs.writeFileSync(petFilePath, content);
    }

    // Generate Info.plist
    const infoPlistPath = path.join(projectPath, 'Info.plist');
    const infoPlist = `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>${bundleId}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${projectName}</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>armv7</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>`;
    fs.writeFileSync(infoPlistPath, infoPlist);

    // Update other Swift files
    const contentViewPath = path.join(projectPath, 'ContentView.swift');
    if (fs.existsSync(contentViewPath)) {
      let content = fs.readFileSync(contentViewPath, 'utf8');
      content = content.replace(/VirtualPet/g, projectName);
      fs.writeFileSync(contentViewPath, content);
    }

    const appFilePath = path.join(projectPath, 'VirtualPetApp.swift');
    if (fs.existsSync(appFilePath)) {
      let content = fs.readFileSync(appFilePath, 'utf8');
      content = content.replace(/VirtualPetApp/g, `${projectName}App`);
      fs.writeFileSync(appFilePath, content);
    }
  }

  addPetFeature(projectPath, options = {}) {
    projectPath = path.resolve(projectPath);
    console.log(`Adding pet features to: ${projectPath}`);

    // Check if it's a valid project
    if (!fs.existsSync(path.join(projectPath, 'Pet.swift'))) {
      console.error('Not a valid VirtualPet project');
      return false;
    }

    // Add or update pet features based on options
    if (options.petType) {
      this.updatePetType(projectPath, options.petType);
    }

    if (options.includeAchievements !== false) {
      this.addAchievementSystem(projectPath);
    }

    if (options.includeAnimations !== false) {
      this.addAnimations(projectPath);
    }

    console.log('✅ Pet features added successfully');
    return true;
  }

  updatePetType(projectPath, petType) {
    const petFilePath = path.join(projectPath, 'Pet.swift');
    if (fs.existsSync(petFilePath)) {
      let content = fs.readFileSync(petFilePath, 'utf8');
      content = content.replace(/petType: PetType = \.\w+/, `petType: PetType = .${petType}`);
      fs.writeFileSync(petFilePath, content);
    }
  }

  addAchievementSystem(projectPath) {
    // Implementation for adding achievement system
    console.log('Adding achievement system...');
  }

  addAnimations(projectPath) {
    // Implementation for adding animations
    console.log('Adding animations...');
  }

  customizePet(projectPath, customizations = {}) {
    projectPath = path.resolve(projectPath);
    console.log(`Customizing pet for: ${projectPath}`);

    const petFilePath = path.join(projectPath, 'Pet.swift');
    if (!fs.existsSync(petFilePath)) {
      console.error('Pet.swift not found');
      return false;
    }

    let content = fs.readFileSync(petFilePath, 'utf8');

    // Apply customizations
    if (customizations.initialStats) {
      const stats = customizations.initialStats;
      const initParams = [
        `hunger=${stats.hunger || 50}`,
        `happiness=${stats.happiness || 50}`,
        `health=${stats.health || 100}`,
        `energy=${stats.energy || 100}`
      ].join(', ');

      // Update init method
      content = content.replace(
        'init\\(hunger: Int = 50, happiness: Int = 50, health: Int = 100\\)',
        `init(${initParams})`
      );
    }

    // Update interaction effects
    if (customizations.interactionEffects) {
      for (const [interaction, effects] of Object.entries(customizations.interactionEffects)) {
        const effectStatements = [];

        if (effects.hunger !== undefined) {
          const change = effects.hunger;
          const op = change > 0 ? '+' : '';
          effectStatements.push(`hunger = clampValue(hunger ${op} ${change})`);
        }

        if (effects.happiness !== undefined) {
          const change = effects.happiness;
          const op = change > 0 ? '+' : '';
          effectStatements.push(`happiness = clampValue(happiness ${op} ${change})`);
        }

        if (effects.health !== undefined) {
          const change = effects.health;
          const op = change > 0 ? '+' : '';
          effectStatements.push(`health = clampValue(health ${op} ${change})`);
        }

        if (effects.energy !== undefined) {
          const change = effects.energy;
          const op = change > 0 ? '+' : '';
          effectStatements.push(`energy = clampValue(energy ${op} ${change})`);
        }

        if (effects.experience !== undefined) {
          effectStatements.push(`experience += ${effects.experience}`);
        }

        if (effectStatements.length > 0) {
          const effectBlock = '{\n        ' + effectStatements.join('\n        ') + '\n        }';
          content = content.replace(
            new RegExp(`case \\.${interaction}: \\{[^}]+\\}`, 'g'),
            `case .${interaction}: ${effectBlock}`
          );
        }
      }
    }

    fs.writeFileSync(petFilePath, content);
    console.log('✅ Pet customized successfully');
    return true;
  }

  updatePetType(projectPath, petType) {
    const petFilePath = path.join(projectPath, 'Pet.swift');
    if (fs.existsSync(petFilePath)) {
      let content = fs.readFileSync(petFilePath, 'utf8');
      content = content.replace(/petType: PetType = \.\w+/, `petType: PetType = .${petType}`);
      fs.writeFileSync(petFilePath, content);
    }
  }

  addAchievementSystem(projectPath) {
    console.log('Adding achievement system...');
  }

  addAnimations(projectPath) {
    console.log('Adding animations...');
  }

  copyDirectory(src, dest) {
    if (!fs.existsSync(dest)) {
      fs.mkdirSync(dest, { recursive: true });
    }

    const entries = fs.readdirSync(src, { withFileTypes: true });

    for (const entry of entries) {
      const srcPath = path.join(src, entry.name);
      const destPath = path.join(dest, entry.name);

      if (entry.isDirectory()) {
        this.copyDirectory(srcPath, destPath);
      } else {
        fs.copyFileSync(srcPath, destPath);
      }
    }
  }

  parseSimpleYAML(yamlContent) {
    const config = {};
    const lines = yamlContent.split('\n');

    for (const line of lines) {
      const trimmed = line.trim();
      if (trimmed && !trimmed.startsWith('#')) {
        const colonIndex = trimmed.indexOf(':');
        if (colonIndex > 0) {
          const key = trimmed.substring(0, colonIndex).trim();
          let value = trimmed.substring(colonIndex + 1).trim();

          // Remove quotes if present
          if (value.startsWith('"') && value.endsWith('"')) {
            value = value.substring(1, value.length - 1);
          } else if (value.startsWith("'") && value.endsWith("'")) {
            value = value.substring(1, value.length - 1);
          }

          // Parse boolean values
          if (value === 'true') {
            config[key] = true;
          } else if (value === 'false') {
            config[key] = false;
          } else if (!isNaN(value)) {
            config[key] = Number(value);
          } else {
            config[key] = value;
          }
        }
      }
    }

    return config;
  }

  showHelp() {
    console.log(`
VirtualPet Skill - Virtual Pet Management Tool

Usage: node skill.js [command] [options]

Commands:
  help                    Show this help message
  list                    List available skills
  create [options]         Create a new VirtualPet project
  add [options]           Add pet features to existing project
  customize [options]     Customize pet settings

Options:
  --project-dir <path>    Project directory (default: current directory)
  --project-name <name>   Project name (default: VirtualPet)
  --pet-type <type>       Pet type: cat, dog, rabbit, hamster, bird
  --bundle-id <id>        Bundle identifier (default: com.example.virtualpet)
  --deployment-target <version> iOS deployment target (default: 17.0)
  --no-achievements       Disable achievement system
  --no-animations          Disable animations
  --no-persistence        Disable data persistence
  --no-activity-log       Disable activity logging

Examples:
  node skill.js create --project-name MyPet
  node skill.js create --pet-type dog --bundle-id com.mycompany.mypet
  node skill.js add --project-dir ./MyPet --pet-type rabbit
  node skill.js customize --project-dir ./MyPet --initial-stats hunger:30,happiness:70
`);
  }
}

// Command line interface
if (require.main === module) {
  const skill = new VirtualPetSkill();
  const args = process.argv.slice(2);

  if (args.length === 0 || args[0] === 'help') {
    skill.showHelp();
    process.exit(0);
  }

  const command = args[0];
  const options = {};

  // Parse command line arguments
  for (let i = 1; i < args.length; i += 2) {
    const key = args[i];
    const value = args[i + 1];

    if (key.startsWith('--')) {
      options[key.substring(2)] = value;
    }
  }

  // Execute command
  try {
    switch (command) {
      case 'list':
        skill.listSkills();
        break;
      case 'create':
        skill.createProject(options);
        break;
      case 'add':
        skill.addPetFeature(options.projectDir || process.cwd(), options);
        break;
      case 'customize':
        skill.customizePet(options.projectDir || process.cwd(), options);
        break;
      default:
        console.error(`Unknown command: ${command}`);
        skill.showHelp();
        process.exit(1);
    }
  } catch (error) {
    console.error(`Error: ${error.message}`);
    process.exit(1);
  }
}

module.exports = VirtualPetSkill;